# ============================================================================
# AI 供应商配置示例 —— 复制成 .hermes/ai.env 后填自己的值
#
#   cp .hermes/ai.env.example .hermes/ai.env
#
# 【重要】.hermes/ai.env 已被 .gitignore 忽略，**永远不会进 Git**。
#         真实 key 只能写在这个文件里（或写成环境变量），
#         不要写进 application.properties、README、任何被 git 跟踪的文件。
#
# 这些变量名与 Spring 的占位符一一对应（见 src/main/resources/application.properties）：
#   WHATIF_AI_PROVIDER / WHATIF_AI_BASE_URL / WHATIF_AI_MODEL / WHATIF_AI_API_KEY
# ============================================================================

# 供应商类型。默认 dashscope（阿里云百炼）；也可用 openai-compatible 接任意兼容网关
export WHATIF_AI_PROVIDER=openai-compatible

# 接口地址。注意：**不带 /v1**（本项目按 OpenAI 兼容协议拼接路径）
export WHATIF_AI_BASE_URL=https://your-gateway.example.com/your/path

# 模型名。也可以直接用官方地址，例如：
#   百炼:     WHATIF_AI_PROVIDER=dashscope  WHATIF_AI_MODEL=qwen-plus
#   DeepSeek: WHATIF_AI_PROVIDER=deepseek   WHATIF_AI_MODEL=deepseek-chat
#   本地Ollama: WHATIF_AI_PROVIDER=ollama   WHATIF_AI_BASE_URL=http://127.0.0.1:11434  WHATIF_AI_MODEL=qwen2.5:7b
export WHATIF_AI_MODEL=your-model-name

# ★ 你的 API Key。写在这里，或者干脆不写这个文件、用系统环境变量传。
#   不配 key 也能跑：平台会降级到确定性路径（判列走规则基线、情景只能手工构造），
#   并且错误码会明确区分「1001 未启用」和「1005 上游欠费/限流」。
export WHATIF_AI_API_KEY=your-api-key-here
