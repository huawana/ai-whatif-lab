<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.whatif</groupId>
    <artifactId>ai-whatif-lab</artifactId>
    <version>1.0.0</version>
    <name>ai-whatif-lab</name>
    <description>AI What-If Lab —— 面向业务决策的智能仿真实验平台</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <mybatis-plus.version>3.5.9</mybatis-plus.version>

        <!-- Spring AI Alibaba 1.1.2.4-security-fix 依据（实测，非照抄文档）：
             官方兼容矩阵写「SAA 1.1.2.x → Spring Boot 3.5.x」，本项目父 POM 是 3.3.5，
             按文档属于「不支持」档。本地探针工程实测结论：
               ① 依赖解析成功，Boot 版本被本项目父 POM 钉回 3.3.5，零冲突警告
               ② 真实启动上下文成功，dashScopeChatModel 与 ReactAgent 均可构建
             诚实边界：这证明的是「类加载 + 手工装配 + Agent 构建」；
             流式 / MCP / graph 持久化等边缘路径未验证。一旦踩到 NoSuchMethodError，
             正解是升 Boot 到 3.5.x（SAA 保持不变）。 -->
        <spring-ai-alibaba.version>1.1.2.4-security-fix</spring-ai-alibaba.version>
        <spring-ai.version>1.1.2</spring-ai.version>
    </properties>

    <!-- ==================== AI 依赖版本统一管理（官方推荐三 BOM） ====================
         为什么必须引三个 BOM：SAA 的模块分属两个 bom，且 dashscope starter 不在
         spring-ai-alibaba-bom 里（该 bom 只管 agent-framework / graph-core / studio 等 8 个 artifact）。
         只引一个会直接报「dependency.version is missing」。
           spring-ai-alibaba-bom          → agent-framework / graph-core / studio / sandbox
           spring-ai-alibaba-extensions-bom → starter-dashscope / memory / nl2sql 等
           spring-ai-bom (org.springframework.ai) → 上游 Spring AI 本体
         ============================================================================= -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-extensions-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web / 参数校验 / 监控 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 持久层：Boot 3 必须用 mybatis-plus-spring-boot3-starter（不是 mybatis-plus-boot-starter，
             后者会因 mybatis-spring 版本不匹配启动失败） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MyBatis-Plus 3.5.9 起把依赖 JSqlParser 的能力（分页插件等）拆了出去，
             只引 starter 会在编译期报「找不到符号 PaginationInnerInterceptor」。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 缓存 / 分布式锁 / SingleFlight -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Kafka：默认不启用（whatif.dispatch.mode=local），置 kafka 时生效。
             没有 broker 时 @KafkaListener 不会注册（条件装配），不影响启动。 -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ==================== Spring AI Alibaba ====================
             agent-framework : ReactAgent（ReAct 循环）+ 工具注册 + Hooks
             graph-core      : Agent 底层图运行时（Model Node / Tool Node）
             starter-dashscope : 通义千问 ChatModel（本项目手工装配，自动配置全部 exclude） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>

        <!-- ==================== 可切换模型供应商 ====================
             加这个**核心模块**（不是 spring-ai-starter-model-openai）是刻意的：
             starter 会带来一批自动配置，重演 DashScope 那个坑（缺 key 时在容器 refresh 阶段抛异常、
             直接把整个应用拖死）。核心模块只有 OpenAiApi / OpenAiChatModel，没有自动配置，
             装配权 100% 留在本项目的 AiModelConfig 里 —— 与 DashScope 的处理保持一致。

             它实现的是 OpenAI 兼容协议（POST {baseUrl}/chat/completions），所以一个依赖覆盖：
               DeepSeek / Moonshot(Kimi) / 智谱GLM / 硅基流动 / OpenRouter / 本地 Ollama、vLLM、llama.cpp …
             版本由 spring-ai-bom 统一管理，这里不写版本号。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
